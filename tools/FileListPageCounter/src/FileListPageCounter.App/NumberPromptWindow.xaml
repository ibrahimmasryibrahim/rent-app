<Window x:Class="FileListPageCounter.App.NumberPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Icon="Assets/app.ico"
        Background="{StaticResource AppBackground}">

    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10" />

        <TextBox x:Name="ValueBox"
                 Padding="6,5"
                 FontSize="15"
                 PreviewTextInput="OnPreviewTextInput" />

        <TextBlock x:Name="RangeText"
                   Margin="0,6,0,14"
                   FontSize="12"
                   Foreground="{StaticResource AppMuted}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إلغاء" MinWidth="100" Click="OnCancel" IsCancel="True" />
            <Button Content="موافق"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="120"
                    Margin="0"
                    Click="OnConfirm"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
