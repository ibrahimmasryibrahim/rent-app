<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileListPageCounter.App</RootNamespace>
    <AssemblyName>FileListPageCounter</AssemblyName>
    <AssemblyTitle>FILE LIST &amp; PAGE COUNTER</AssemblyTitle>
    <Product>FILE LIST &amp; PAGE COUNTER</Product>
    <Description>استخراج أسماء الملفات وعدد الصفحات</Description>
    <Authors>Ibrahim Masry Ibrahim</Authors>
    <Company>Ibrahim Masry Ibrahim</Company>
    <Copyright>© Ibrahim Masry Ibrahim</Copyright>
    <Version>2.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileListPageCounter.Core\FileListPageCounter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also shipped as content so the window and shortcuts can show the same mark. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
