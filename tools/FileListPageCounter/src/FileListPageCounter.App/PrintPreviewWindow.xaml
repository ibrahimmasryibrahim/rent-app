<Window x:Class="FileListPageCounter.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة الطباعة"
        Height="860" Width="1000"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Icon="Assets/app.ico"
        Background="{StaticResource AppBackground}">

    <DockPanel>

        <!-- printer properties -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">

                    <StackPanel Margin="0,0,20,0" MinWidth="260">
                        <TextBlock Text="الطابعة" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="PrinterBox" MinWidth="250" FontSize="13" />
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0" MinWidth="90">
                        <TextBlock Text="عدد النسخ" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="CopiesBox" Text="1" Padding="6,4" FontSize="13"
                                 PreviewTextInput="OnDigitsOnly" />
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0" MinWidth="200">
                        <TextBlock Text="نطاق الصفحات" Style="{StaticResource LabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" />
                            <TextBox x:Name="FromBox" Width="60" Padding="6,4" FontSize="13"
                                     PreviewTextInput="OnDigitsOnly" />
                            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="13" />
                            <TextBox x:Name="ToBox" Width="60" Padding="6,4" FontSize="13"
                                     PreviewTextInput="OnDigitsOnly" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="مقاس الورق واتجاهه" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="A4 — عمودي" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="⚙  خصائص الطابعة المتقدمة"
                                MinWidth="210"
                                Margin="0"
                                Click="OnAdvancedProperties"
                                ToolTip="يفتح نافذة إعدادات مشغّل الطابعة نفسها" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ExportButton}"
                            Background="#374B5D"
                            Tag="#4A6076"
                            MinWidth="170"
                            Click="OnPrint">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="طباعة" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="إغلاق" MinWidth="110" Click="OnClose" IsCancel="True" />

                    <TextBlock x:Name="PageCountText"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource AppMuted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DocumentViewer x:Name="Viewer" Background="#E9EDF2" />
    </DockPanel>
</Window>
