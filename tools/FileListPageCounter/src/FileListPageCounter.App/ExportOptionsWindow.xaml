<Window x:Class="FileListPageCounter.App.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خيارات التصدير"
        SizeToContent="Height"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{StaticResource AppBackground}">

    <StackPanel Margin="18">

        <TextBlock x:Name="HeadingText"
                   Style="{StaticResource HeadingStyle}"
                   Text="خيارات التصدير" />

        <TextBlock x:Name="SubHeadingText"
                   Margin="0,4,0,14"
                   FontSize="13"
                   Foreground="{StaticResource AppMuted}" />

        <!-- Title -->
        <Border Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="عنوان التقرير" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="TitleBox" Padding="6,5" FontSize="14" />
            </StackPanel>
        </Border>

        <!-- Layout -->
        <Border x:Name="LayoutPanel" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="توزيع الجدول على الصفحة" Style="{StaticResource LabelStyle}" />
                <TextBlock Margin="0,0,0,10"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AppMuted}"
                           Text="تكرار الأعمدة الثلاثة عرضيًا يستغل عرض الصفحة كاملًا ويقلّل عدد الصفحات كثيرًا." />

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OneBlock" GroupName="Blocks" Margin="0,0,26,0" FontSize="14"
                                 Content="عمود واحد" IsChecked="True"
                                 Checked="OnLayoutChanged" />
                    <RadioButton x:Name="TwoBlocks" GroupName="Blocks" Margin="0,0,26,0" FontSize="14"
                                 Content="عمودان" Checked="OnLayoutChanged" />
                    <RadioButton x:Name="ThreeBlocks" GroupName="Blocks" FontSize="14"
                                 Content="ثلاثة أعمدة" Checked="OnLayoutChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Font size -->
        <Border Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="حجم الخط" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="FontSizeBox" Width="130" HorizontalAlignment="Right"
                          SelectionChanged="OnFontSizeChanged" />
                <TextBlock x:Name="FontHint"
                           Margin="0,8,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="#B45309" />
            </StackPanel>
        </Border>

        <!-- Estimate -->
        <Border x:Name="EstimatePanel"
                Background="#EEF4FA"
                BorderBrush="#BFCBD9"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="EstimateText" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1F4E79" TextWrapping="Wrap" />
                <TextBlock x:Name="EstimateDetail" Margin="0,5,0,0" FontSize="12"
                           Foreground="{StaticResource AppMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <CheckBox x:Name="OpenWhenDoneBox"
                  Content="فتح الملف بعد إنشائه"
                  IsChecked="True"
                  Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إلغاء" MinWidth="110" Click="OnCancel" IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    Content="متابعة واختيار مكان الحفظ"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="220"
                    Margin="0"
                    Click="OnConfirm"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
