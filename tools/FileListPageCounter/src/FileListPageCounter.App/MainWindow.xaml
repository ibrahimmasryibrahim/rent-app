<Window x:Class="FileListPageCounter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FILE LIST &amp; PAGE COUNTER — استخراج أسماء الملفات وعدد الصفحات"
        Height="760" Width="1020"
        MinHeight="620" MinWidth="880"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and source selection -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="استخراج أسماء الملفات وعدد الصفحات" Style="{StaticResource HeadingStyle}" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{StaticResource AppMuted}"
                           FontSize="13"
                           Text="تُقرأ الملفات من مكانها على القرص للقراءة فقط — لا تعديل ولا نقل ولا نسخ ولا اتصال بالإنترنت." />

                <StackPanel Orientation="Horizontal">
                    <Button Content="📁  اختيار مجلد" Command="{Binding SelectFolderCommand}" />
                    <Button Content="📄  اختيار ملفات" Command="{Binding SelectFilesCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Current source -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="المصدر:" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding SourceDescription}"
                               Style="{StaticResource ValueStyle}"
                               ToolTip="{Binding SourceDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0" MinWidth="90">
                    <TextBlock Text="عدد الملفات" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding TotalFiles, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0" MinWidth="90">
                    <TextBlock Text="إجمالي الصفحات" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding TotalPages, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="16,0,0,0" MinWidth="110">
                    <TextBlock Text="تعذر تحديدها" Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="{Binding UnknownCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Options -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="الخيارات" Style="{StaticResource LabelStyle}" />
                    <CheckBox Content="تضمين المجلدات الفرعية" IsChecked="{Binding IncludeSubdirectories}" />
                    <CheckBox Content="تجاهل الملفات غير المدعومة" IsChecked="{Binding IgnoreUnsupportedFiles}" />
                    <CheckBox Content="احتساب صفحات ملفات TIFF متعددة الصفحات" IsChecked="{Binding CountTiffFrames}" />
                    <CheckBox Content="التحقق من عدم تغيّر الملفات الأصلية بعد الفحص" IsChecked="{Binding VerifyIntegrity}" />
                    <CheckBox Content="استخدام اسم المجلد كعنوان للتقرير" IsChecked="{Binding UseFolderNameAsTitle}" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" MinWidth="270">
                    <TextBlock Text="عنوان التقرير" Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,5"
                             FontSize="14"
                             Margin="0,0,0,12"
                             ToolTip="يظهر في أعلى ملف Word و Excel، ويُقترح كاسم للملف عند الحفظ." />

                    <TextBlock Text="ترتيب الملفات" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label"
                              Margin="0,0,0,10" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource AppMuted}"
                               Text="حجم الخط وتوزيع الجدول على الصفحة يُختاران عند التصدير." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="3" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="معاينة النتائج قبل إنشاء Word" Style="{StaticResource LabelStyle}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          RowHeaderWidth="0"
                          FontSize="14"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AlternatingRowBackground="#F7F9FB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="م" Binding="{Binding Index}" Width="70" />
                        <DataGridTextColumn Header="اسم الملف" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="عدد الصفحات" Binding="{Binding PageCountText}" Width="140" />
                        <DataGridTextColumn Header="المسار" Binding="{Binding FullPath}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions and status -->
        <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Margin="0">
            <StackPanel>
                <TextBlock Text="تصدير التقرير" Style="{StaticResource LabelStyle}" />

                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <Button Style="{StaticResource ExportButton}"
                            Background="{StaticResource WordBlue}"
                            Tag="{StaticResource WordBlueHover}"
                            Command="{Binding CreateWordCommand}"
                            ToolTip="إنشاء تقرير Word (‎.docx‎) منسّق وجاهز للطباعة">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="تصدير إلى Word" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ExportButton}"
                            Background="{StaticResource ExcelGreen}"
                            Tag="{StaticResource ExcelGreenHover}"
                            Command="{Binding CreateExcelCommand}"
                            ToolTip="إنشاء جدول Excel (‎.xlsx‎) قابل للفرز والجمع">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="19" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="تصدير إلى Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding ExportHint}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource AppMuted}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="🗑  مسح" Command="{Binding ClearCommand}" MinWidth="100" />
                    <Button Content="⏹  إيقاف" Command="{Binding CancelCommand}" MinWidth="100" />
                    <Button Content="📋  حفظ سجل التفاصيل"
                            Command="{Binding SaveLogCommand}"
                            MinWidth="160"
                            Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Text="حالة المعالجة:" Style="{StaticResource LabelStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Height="18"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Margin="0,0,12,0" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               MinWidth="200" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Column="1"
                               FlowDirection="LeftToRight"
                               Foreground="{StaticResource AppMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Text="Developed by Ibrahim Masry Ibrahim" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
