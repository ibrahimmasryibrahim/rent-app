<Window x:Class="FileListPageCounter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File List &amp; Page Counter"
        Height="820" Width="1120"
        MinHeight="640" MinWidth="920"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{StaticResource AppBackground}"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ 1. source ============================ -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁  اختيار مجلد" Command="{Binding SelectFolderCommand}" />
                    <Button Content="📄  اختيار ملفات" Command="{Binding SelectFilesCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="استخراج أسماء الملفات وعدد الصفحات" Style="{StaticResource HeadingStyle}" FontSize="16" />
                    <TextBlock Text="{Binding SourceDescription}"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceDescription}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" MinWidth="80">
                        <TextBlock Text="الصفوف" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding TotalFiles, StringFormat={}{0:N0}}" FontSize="19" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" MinWidth="90">
                        <TextBlock Text="إجمالي الصفحات" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding TotalPages, StringFormat={}{0:N0}}" FontSize="19" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel MinWidth="90">
                        <TextBlock Text="تعذر تحديدها" Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding UnknownCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 2. options =========================== -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,24,0" MinWidth="240">
                    <TextBlock Text="عنوان التقرير" Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,5" FontSize="14" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0" MinWidth="110">
                    <TextBlock Text="حجم الخط" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" MinWidth="100" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0" MinWidth="110">
                    <TextBlock Text="أعمدة الصفحة" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding ColumnBlockChoices}" SelectedItem="{Binding ColumnBlocks}" MinWidth="100" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0" MinWidth="220">
                    <TextBlock Text="عدد الصفوف في الصفحة" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding RowsPerPageOptions}"
                              SelectedItem="{Binding SelectedRowsPerPage}"
                              DisplayMemberPath="Label"
                              MinWidth="210" />
                </StackPanel>

                <StackPanel Margin="0,0,24,0" MinWidth="230">
                    <CheckBox Content="إظهار اسم المستخدم أسفل الصفحات"
                              IsChecked="{Binding ShowUserName}"
                              Margin="0,0,0,5" />
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="13"
                             IsEnabled="{Binding ShowUserName}"
                             ToolTip="يظهر بحجم صغير جدًا أسفل كل صفحة" />
                </StackPanel>

                <StackPanel MinWidth="250">
                    <TextBlock Text="خيارات القراءة" Style="{StaticResource LabelStyle}" />
                    <CheckBox Content="تضمين المجلدات الفرعية" IsChecked="{Binding IncludeSubdirectories}" Margin="0,0,0,4" />
                    <CheckBox Content="تجاهل الملفات غير المدعومة" IsChecked="{Binding IgnoreUnsupportedFiles}" Margin="0,0,0,4" />
                    <CheckBox Content="احتساب صفحات TIFF المتعددة" IsChecked="{Binding CountTiffFrames}" Margin="0,0,0,4" />
                    <CheckBox Content="التحقق من سلامة الملفات الأصلية" IsChecked="{Binding VerifyIntegrity}" Margin="0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ==================== 3. table and live preview ==================== -->
        <TabControl Grid.Row="2" Margin="0,0,0,12" Background="Transparent" BorderThickness="0">

            <TabItem Header="  الجدول  " FontSize="14">
                <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="➕  صف جديد" Command="{Binding AddRowCommand}" MinWidth="120" />
                            <Button Content="🗑  حذف المحدد" Command="{Binding DeleteRowsCommand}" MinWidth="130" />
                            <Button Content="▲  لأعلى" Command="{Binding MoveUpCommand}" MinWidth="100" />
                            <Button Content="▼  لأسفل" Command="{Binding MoveDownCommand}" MinWidth="100" />
                            <Button Content="🔢  إعادة الترقيم" Command="{Binding RenumberCommand}" MinWidth="140" />

                            <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                                       Foreground="{StaticResource AppMuted}"
                                       Text="انقر مرّتين على أي خلية لتعديلها — التعديل على الجدول فقط ولا يمسّ الملف الأصلي." />
                        </StackPanel>

                        <DataGrid x:Name="RowsGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Rows}"
                                  SelectionChanged="OnRowsGridSelectionChanged"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E6EBF1"
                                  RowHeaderWidth="0"
                                  FontSize="14"
                                  RowHeight="30"
                                  BorderBrush="{StaticResource AppBorder}"
                                  BorderThickness="1"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F7F9FB"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م" Width="70"
                                                    Binding="{Binding Index, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="اسم الملف" Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="عدد الصفحات" Width="130"
                                                    Binding="{Binding PageCountText, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="المسار الأصلي" Width="300" IsReadOnly="True"
                                                    Binding="{Binding SourcePath}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="  معاينة الطباعة  " FontSize="14">
                <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="14,10"
                                   FontSize="13"
                                   Foreground="{StaticResource AppMuted}"
                                   Text="{Binding PreviewSummary}" />

                        <DocumentViewer Grid.Row="1"
                                        Document="{Binding PreviewDocument}"
                                        Background="#E9EDF2" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ========================= 4. output bar ========================== -->
        <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource ExportButton}"
                            Background="{StaticResource WordBlue}"
                            Tag="{StaticResource WordBlueHover}"
                            Command="{Binding SaveWordCommand}"
                            ToolTip="حفظ التقرير كملف Word (‎.docx‎)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="حفظ Word" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ExportButton}"
                            Background="{StaticResource ExcelGreen}"
                            Tag="{StaticResource ExcelGreenHover}"
                            Command="{Binding SaveExcelCommand}"
                            MinWidth="180"
                            ToolTip="حفظ الجدول كملف Excel (‎.xlsx‎)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="حفظ Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ExportButton}"
                            Background="#374B5D"
                            Tag="#4A6076"
                            Command="{Binding PrintCommand}"
                            MinWidth="170"
                            ToolTip="معاينة الطباعة ثم الإرسال إلى الطابعة">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="طباعة" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="إلغاء ومسح" Command="{Binding ClearCommand}" MinWidth="120" />
                    <Button Content="⏹  إيقاف" Command="{Binding CancelCommand}" MinWidth="100" />
                    <Button Content="📋  سجل التفاصيل"
                            Command="{Binding SaveLogCommand}"
                            MinWidth="150"
                            Visibility="{Binding HasLogEntries, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding ExportHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource AppMuted}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />

                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource AppMuted}" MinWidth="150" />

                    <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                               VerticalAlignment="Center" FontSize="12"
                               Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"
                               Foreground="{StaticResource AppMuted}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
